<?xml version="1.0" encoding="utf-8"?>
<!--
  Vancouver (reference list entries), following the NLM's Citing Medicine,
  2nd ed., as recommended by the ICMJE. Project-authored for Borges
  Bibliography Builder from those rules; GPL-2.0-or-later. Not derived from
  the CSL project's vancouver.csl. Shared conventions: docs/csl-styles.md.
  The block numbers entries itself, so no citation number is rendered.
  Journal titles print as stored (Citing Medicine abbreviates them).
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="sort-only" page-range-format="minimal" initialize-with-hyphen="true">
  <info>
    <title>Borges: Vancouver</title>
    <id>https://github.com/dknauss/Borges/styles/vancouver</id>
    <author><name>Borges Bibliography Builder contributors</name></author>
    <category citation-format="numeric"/>
    <updated>2026-09-26T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-2.0.html">GPL-2.0-or-later</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="no date" form="short">date unknown</term>
      <term name="month-01" form="short">Jan</term>
      <term name="month-02" form="short">Feb</term>
      <term name="month-03" form="short">Mar</term>
      <term name="month-04" form="short">Apr</term>
      <term name="month-05" form="short">May</term>
      <term name="month-06" form="short">Jun</term>
      <term name="month-07" form="short">Jul</term>
      <term name="month-08" form="short">Aug</term>
      <term name="month-09" form="short">Sep</term>
      <term name="month-10" form="short">Oct</term>
      <term name="month-11" form="short">Nov</term>
      <term name="month-12" form="short">Dec</term>
    </terms>
  </locale>

  <macro name="creators">
    <choose>
      <if variable="author">
        <names variable="author">
          <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
          <label form="long" prefix=", "/>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="container-editors">
    <names variable="editor">
      <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
      <label form="long" prefix=", "/>
    </names>
  </macro>

  <macro name="translators">
    <names variable="translator">
      <name delimiter=", " delimiter-precedes-et-al="always" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
      <label form="long" prefix=", "/>
    </names>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short" prefix="[" suffix="]"/>
      </else>
    </choose>
  </macro>

  <macro name="full-date">
    <date variable="issued">
      <date-part name="year"/>
      <date-part name="month" form="short" prefix=" "/>
      <date-part name="day" prefix=" "/>
    </date>
  </macro>

  <macro name="cited">
    <group delimiter=" " prefix="[" suffix="]">
      <text term="cited"/>
      <date variable="accessed">
        <date-part name="year"/>
        <date-part name="month" form="short" prefix=" "/>
        <date-part name="day" prefix=" "/>
      </date>
    </group>
  </macro>

  <macro name="place-publisher-year">
    <group delimiter="; ">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <text value="p."/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="available">
    <group delimiter=" ">
      <text value="Available from:"/>
      <text variable="URL"/>
    </group>
  </macro>

  <bibliography hanging-indent="false" et-al-min="7" et-al-use-first="6">
    <layout>
      <group delimiter=" ">
        <text macro="creators" suffix="."/>
        <choose>
          <if type="article-journal review review-book" match="any">
            <text variable="title" suffix="."/>
            <group delimiter="" suffix=".">
              <text variable="container-title" suffix=". "/>
              <text macro="full-date"/>
              <text variable="volume" prefix=";"/>
              <text variable="issue" prefix="(" suffix=")"/>
              <text variable="page" prefix=":"/>
            </group>
            <text variable="DOI" prefix="doi:"/>
          </if>
          <else-if type="article-magazine article-newspaper" match="any">
            <text variable="title" suffix="."/>
            <choose>
              <if variable="URL">
                <group delimiter=" ">
                  <group delimiter=" " suffix=".">
                    <text variable="container-title" suffix=" [Internet]."/>
                    <text macro="full-date"/>
                    <text macro="cited"/>
                  </group>
                  <text macro="available"/>
                </group>
              </if>
              <else>
                <group delimiter=" ">
                  <text variable="container-title" suffix="."/>
                  <text macro="full-date" suffix="."/>
                </group>
              </else>
            </choose>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <text variable="title" suffix=" [Internet]."/>
            <group delimiter=" " suffix=".">
              <group delimiter="; ">
                <text variable="container-title"/>
                <choose>
                  <if variable="issued">
                    <text macro="full-date"/>
                  </if>
                </choose>
              </group>
              <text macro="cited"/>
            </group>
            <text macro="available"/>
          </else-if>
          <else-if type="chapter paper-conference entry entry-encyclopedia entry-dictionary" match="any">
            <text variable="title" suffix="."/>
            <group delimiter=" " suffix=".">
              <text value="In:"/>
              <text macro="container-editors" suffix="."/>
              <text variable="container-title"/>
            </group>
            <text macro="place-publisher-year" suffix="."/>
            <text macro="pages" suffix="."/>
            <text variable="DOI" prefix="doi:"/>
          </else-if>
          <else-if type="thesis">
            <group delimiter=" " suffix=".">
              <text variable="title"/>
              <text variable="genre" prefix="[" suffix="]"/>
            </group>
            <text macro="place-publisher-year" suffix="."/>
          </else-if>
          <else-if type="report">
            <text variable="title" suffix="."/>
            <text macro="place-publisher-year" suffix="."/>
            <group delimiter=" " suffix=".">
              <text value="Report No.:"/>
              <text variable="number"/>
            </group>
            <text variable="DOI" prefix="doi:"/>
          </else-if>
          <else-if type="article">
            <group delimiter=" " suffix=".">
              <text variable="title"/>
              <text value="[Preprint]"/>
            </group>
            <group delimiter="; " suffix=".">
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
            <text variable="DOI" prefix="doi:"/>
          </else-if>
          <else-if type="legal_case legislation" match="any">
            <text variable="title" suffix="."/>
            <group delimiter=" " suffix=".">
              <text variable="container-title"/>
              <text variable="number"/>
            </group>
            <text macro="year" suffix="."/>
          </else-if>
          <else>
            <text variable="title" suffix="."/>
            <choose>
              <if variable="author">
                <text macro="container-editors" suffix="."/>
              </if>
            </choose>
            <text macro="translators" suffix="."/>
            <text macro="edition" suffix="."/>
            <text macro="place-publisher-year" suffix="."/>
            <text variable="DOI" prefix="doi:"/>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
