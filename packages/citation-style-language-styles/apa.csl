<?xml version="1.0" encoding="utf-8"?>
<!--
  APA Style, 7th edition (reference list entries), following the Publication
  Manual of the American Psychological Association, 7th ed., chapters 9-10.
  Project-authored for Borges Bibliography Builder from the manual's rules;
  GPL-2.0-or-later. Not derived from the CSL project's apa.csl. Shared
  conventions: docs/csl-styles.md. Titles keep their stored capitalization
  (APA's sentence case is not applied).
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never" initialize-with-hyphen="true">
  <info>
    <title>Borges: APA 7th Edition</title>
    <id>https://github.com/dknauss/Borges/styles/apa</id>
    <author><name>Borges Bibliography Builder contributors</name></author>
    <category citation-format="author-date"/>
    <updated>2026-09-26T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-2.0.html">GPL-2.0-or-later</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short"><single>Ed.</single><multiple>Eds.</multiple></term>
      <term name="translator" form="short"><single>Trans.</single><multiple>Trans.</multiple></term>
      <term name="retrieved">retrieved</term>
    </terms>
  </locale>

  <macro name="creators">
    <names variable="author">
      <name and="symbol" delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=", " initialize-with=". "/>
      <label form="short" prefix=" (" suffix=")" text-case="capitalize-first"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <macro name="container-editors">
    <names variable="editor">
      <name and="symbol" delimiter=", " initialize-with=". "/>
      <label form="short" prefix=" (" suffix=")" text-case="capitalize-first"/>
    </names>
  </macro>

  <macro name="translator-note">
    <choose>
      <if variable="author editor" match="any">
        <names variable="translator">
          <name and="symbol" delimiter=", " initialize-with=". "/>
          <label form="short" prefix=", " text-case="capitalize-first"/>
        </names>
      </if>
    </choose>
  </macro>

  <macro name="date">
    <choose>
      <if variable="issued">
        <choose>
          <if type="article-magazine article-newspaper webpage post post-weblog" match="any">
            <date variable="issued">
              <date-part name="year"/>
              <date-part name="month" prefix=", "/>
              <date-part name="day" prefix=" "/>
            </date>
          </if>
          <else>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </else>
        </choose>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="title-notes">
    <group delimiter="; " prefix=" (" suffix=")">
      <text macro="translator-note"/>
      <text macro="edition"/>
      <group delimiter=" ">
        <text term="volume" form="short" text-case="capitalize-first"/>
        <number variable="volume"/>
      </group>
      <choose>
        <if type="report">
          <group delimiter=" ">
            <text value="Report No."/>
            <text variable="number"/>
          </group>
        </if>
        <else-if type="article">
          <group delimiter=":">
            <text variable="publisher"/>
            <text variable="number"/>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>

  <macro name="title">
    <group>
      <text variable="title"/>
      <choose>
        <if type="book report article" match="any">
          <text macro="title-notes"/>
        </if>
        <else-if type="thesis">
          <group delimiter=", " prefix=" [" suffix="]">
            <text variable="genre"/>
            <text variable="publisher"/>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>

  <macro name="retrieved">
    <group delimiter=" ">
      <text term="retrieved" text-case="capitalize-first"/>
      <date variable="accessed" suffix=",">
        <date-part name="month" suffix=" "/>
        <date-part name="day" suffix=", "/>
        <date-part name="year"/>
      </date>
      <text term="from"/>
      <text variable="URL"/>
    </group>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <choose>
          <if variable="issued" match="none">
            <choose>
              <if variable="accessed">
                <text macro="retrieved"/>
              </if>
              <else>
                <text variable="URL"/>
              </else>
            </choose>
          </if>
          <else>
            <text variable="URL"/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>

  <!-- Sort keys for the PHP/JS sort-coordination tests. Output order is not
       used by the block (it sorts entries itself), and these macros share no
       elements with the display macros, whose name state they would disturb. -->
  <macro name="sort-contributors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="sort-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <bibliography hanging-indent="true" et-al-min="21" et-al-use-first="19" et-al-use-last="true">
    <sort>
      <key macro="sort-contributors"/>
      <key macro="sort-year"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <choose>
          <if variable="author editor translator" match="any">
            <text macro="creators" suffix="."/>
            <text macro="date" prefix="(" suffix=")."/>
            <text macro="title" suffix="."/>
          </if>
          <else>
            <text macro="title" suffix="."/>
            <text macro="date" prefix="(" suffix=")."/>
          </else>
        </choose>
        <choose>
          <if type="article-journal article-magazine article-newspaper review review-book" match="any">
            <group delimiter=", " suffix=".">
              <text variable="container-title"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
            </group>
          </if>
          <else-if type="chapter paper-conference entry entry-encyclopedia entry-dictionary" match="any">
            <group delimiter=" " suffix=".">
              <text term="in" text-case="capitalize-first"/>
              <group delimiter=", ">
                <text macro="container-editors"/>
                <text variable="container-title"/>
              </group>
              <group prefix="(" suffix=")" delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
            <text variable="publisher" suffix="."/>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <text variable="container-title" suffix="."/>
          </else-if>
          <else-if type="thesis"/>
          <else-if type="legal_case">
            <group delimiter=" " suffix=".">
              <text variable="container-title"/>
              <text variable="number"/>
            </group>
          </else-if>
          <else-if type="legislation"/>
          <else>
            <text variable="publisher" suffix="."/>
          </else>
        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
