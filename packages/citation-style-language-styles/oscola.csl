<?xml version="1.0" encoding="utf-8"?>
<!--
  OSCOLA (bibliography entries), following the Oxford University Standard for
  the Citation of Legal Authorities, 5th ed. (2026). Project-authored for Borges
  Bibliography Builder from the standard's rules; GPL-2.0-or-later. Not
  derived from the CSL project's oscola.csl. Shared conventions:
  docs/csl-styles.md.

  Deviation: URLs are printed without OSCOLA's angle brackets, because the
  block links a URL up to the next space and would take the ">" with it.
  OSCOLA entries end without a full stop.

  5th-edition rules: a DOI (or other persistent link) is preferred to a URL,
  and needs no access date; a plain URL is followed by "accessed" and the
  date. Books give the publisher and year, without a place.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="en-GB" demote-non-dropping-particle="never" initialize-with-hyphen="true">
  <info>
    <title>Borges: OSCOLA</title>
    <id>https://github.com/dknauss/Borges/styles/oscola</id>
    <author><name>Borges Bibliography Builder contributors</name></author>
    <category citation-format="note"/>
    <updated>2026-10-05T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-2.0.html">GPL-2.0-or-later</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short"><single>ed</single><multiple>eds</multiple></term>
      <term name="translator" form="short"><single>tr</single><multiple>trs</multiple></term>
      <term name="edition" form="short"><single>edn</single><multiple>edns</multiple></term>
    </terms>
  </locale>

  <macro name="creators">
    <choose>
      <if variable="author">
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
          <et-al term="and others"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=" " initialize-with=""/>
          <et-al term="and others"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="container-editors">
    <names variable="editor">
      <name and="text" delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="translators">
    <group delimiter=" ">
      <names variable="translator">
        <name and="text" delimiter=", " delimiter-precedes-last="never"/>
      </names>
      <text term="translator" form="short"/>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="full-date">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="publisher-year">
    <group delimiter=" ">
      <text variable="publisher"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="online">
    <group delimiter=" ">
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="https://doi.org/"/>
        </if>
        <else>
          <text variable="URL"/>
        </else>
      </choose>
      <choose>
        <if variable="DOI"/>
        <else-if variable="URL">
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>

  <!-- Sort keys for the PHP/JS sort-coordination tests. Output order is not
       used by the block (it sorts entries itself), and these macros share no
       elements with the display macros, whose name state they would disturb. -->
  <macro name="sort-contributors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="sort-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <bibliography hanging-indent="false" et-al-min="4" et-al-use-first="1">
    <sort>
      <key macro="sort-contributors"/>
      <key variable="title"/>
    </sort>
    <layout>
      <choose>
        <if type="legal_case">
          <group delimiter=" ">
            <text variable="title"/>
            <text macro="year" prefix="[" suffix="]"/>
            <text variable="container-title"/>
            <text variable="number"/>
          </group>
        </if>
        <else-if type="legislation">
          <group delimiter=" ">
            <text variable="title"/>
            <text macro="year"/>
          </group>
        </else-if>
        <else-if type="article-journal review review-book" match="any">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title" quotes="true"/>
            </group>
            <text macro="year" prefix="(" suffix=")"/>
            <text variable="volume"/>
            <text variable="container-title"/>
            <text variable="page-first"/>
          </group>
        </else-if>
        <else-if type="article-magazine article-newspaper" match="any">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title" quotes="true"/>
            </group>
            <text variable="container-title"/>
            <text macro="full-date" prefix="(" suffix=")"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="chapter entry entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title" quotes="true"/>
            </group>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in"/>
                <text macro="container-editors"/>
              </group>
              <text variable="container-title"/>
            </group>
            <text macro="publisher-year" prefix="(" suffix=")"/>
          </group>
        </else-if>
        <else-if type="paper-conference thesis article" match="any">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title" quotes="true"/>
            </group>
            <group delimiter=", " prefix="(" suffix=")">
              <text variable="genre"/>
              <text variable="container-title"/>
              <text macro="publisher-year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title" quotes="true"/>
            </group>
            <group delimiter=", " prefix="(" suffix=")">
              <text variable="container-title"/>
              <text macro="full-date"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else>
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="creators"/>
              <text variable="title"/>
            </group>
            <group delimiter=", " prefix="(" suffix=")">
              <choose>
                <if variable="author editor" match="any">
                  <text macro="translators"/>
                </if>
              </choose>
              <text macro="edition"/>
              <text macro="publisher-year"/>
            </group>
            <text macro="online"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
