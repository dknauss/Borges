<?xml version="1.0" encoding="utf-8"?>
<!--
  MLA Style, 9th edition (works-cited entries), following the MLA Handbook,
  9th ed., chapter 5. Project-authored for Borges Bibliography Builder from the
  handbook's rules; GPL-2.0-or-later. Not derived from the CSL project's
  modern-language-association.csl. Shared conventions: docs/csl-styles.md.
  URLs keep their scheme so the block can link them.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>Borges: MLA 9th Edition</title>
    <id>https://github.com/dknauss/Borges/styles/modern-language-association</id>
    <author><name>Borges Bibliography Builder contributors</name></author>
    <category citation-format="author"/>
    <updated>2026-09-26T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-2.0.html">GPL-2.0-or-later</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="month-06" form="short">June</term>
      <term name="month-07" form="short">July</term>
      <term name="month-09" form="short">Sept.</term>
    </terms>
  </locale>

  <macro name="creators">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always" name-as-sort-order="first" sort-separator=", "/>
      <label form="long" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <choose>
      <if type="book report thesis legislation legal_case motion_picture software dataset map" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="editors-verb">
    <group delimiter=" ">
      <text term="editor" form="verb"/>
      <names variable="editor">
        <name and="text" delimiter=", "/>
      </names>
    </group>
  </macro>

  <macro name="translators-verb-capitalized">
    <group delimiter=" ">
      <text term="translator" form="verb" text-case="capitalize-first"/>
      <names variable="translator">
        <name and="text" delimiter=", "/>
      </names>
    </group>
  </macro>

  <macro name="editors-verb-capitalized">
    <group delimiter=" ">
      <text term="editor" form="verb" text-case="capitalize-first"/>
      <names variable="editor">
        <name and="text" delimiter=", "/>
      </names>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="date">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="accessed">
    <group delimiter=" ">
      <text term="accessed" text-case="capitalize-first"/>
      <date variable="accessed">
        <date-part name="day" suffix=" "/>
        <date-part name="month" form="short" suffix=" "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <macro name="container">
    <group delimiter=", ">
      <choose>
        <if type="chapter paper-conference entry entry-encyclopedia entry-dictionary" match="any">
          <text variable="container-title"/>
          <text macro="editors-verb"/>
        </if>
        <else-if type="article-journal article-magazine article-newspaper review review-book webpage post post-weblog" match="any">
          <text variable="container-title"/>
        </else-if>
        <else-if type="book report" match="any">
          <choose>
            <if variable="author">
              <text macro="editors-verb-capitalized"/>
            </if>
          </choose>
          <choose>
            <if variable="author editor" match="any">
              <text macro="translators-verb-capitalized"/>
            </if>
          </choose>
          <text macro="edition"/>
          <group delimiter=" ">
            <text term="volume" form="short"/>
            <number variable="volume"/>
          </group>
        </else-if>
      </choose>
      <choose>
        <if type="article-journal review review-book" match="any">
          <group delimiter=" ">
            <text term="volume" form="short"/>
            <text variable="volume"/>
          </group>
          <group delimiter=" ">
            <text term="issue" form="short"/>
            <text variable="issue"/>
          </group>
        </if>
      </choose>
      <choose>
        <if type="thesis" match="none">
          <text variable="publisher"/>
        </if>
      </choose>
      <choose>
        <if type="legal_case">
          <group delimiter=" ">
            <text variable="container-title"/>
            <text variable="number"/>
          </group>
        </if>
      </choose>
      <choose>
        <if type="thesis">
          <group delimiter=". ">
            <text macro="date"/>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="genre"/>
            </group>
          </group>
        </if>
        <else>
          <text macro="date"/>
        </else>
      </choose>
      <text macro="pages"/>
      <text macro="access"/>
    </group>
  </macro>

  <!-- Sort keys for the PHP/JS sort-coordination tests. Output order is not
       used by the block (it sorts entries itself), and these macros share no
       elements with the display macros, whose name state they would disturb. -->
  <macro name="sort-contributors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="sort-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <bibliography hanging-indent="true" et-al-min="3" et-al-use-first="1">
    <sort>
      <key macro="sort-contributors"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" " suffix=".">
        <text macro="creators" suffix="."/>
        <text macro="title" suffix="."/>
        <text macro="container" suffix="."/>
        <choose>
          <if variable="issued" match="none">
            <text macro="accessed" suffix="."/>
          </if>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
