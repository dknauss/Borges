<?xml version="1.0" encoding="utf-8"?>
<!--
  Harvard author-date (reference list entries), in the widely taught form of
  Cite Them Right, 13th ed. (2025). Project-authored for Borges Bibliography
  Builder from that guide's rules; GPL-2.0-or-later. Not derived from the CSL
  project's harvard styles. Shared conventions: docs/csl-styles.md.

  13th-edition rules: no place of publication; a journal that numbers its
  articles instead of paging them gives "article" and the number.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-GB" demote-non-dropping-particle="never" initialize-with-hyphen="true">
  <info>
    <title>Borges: Harvard (Cite Them Right)</title>
    <id>https://github.com/dknauss/Borges/styles/harvard1</id>
    <author><name>Borges Bibliography Builder contributors</name></author>
    <category citation-format="author-date"/>
    <updated>2026-10-05T00:00:00+00:00</updated>
    <rights license="https://www.gnu.org/licenses/gpl-2.0.html">GPL-2.0-or-later</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short"><single>ed.</single><multiple>eds</multiple></term>
      <term name="edition" form="short"><single>edn</single><multiple>edns</multiple></term>
      <term name="no date" form="short">no date</term>
    </terms>
  </locale>

  <!-- An explicit choice, not <substitute>: citeproc-php treats a substituted
       variable as absent in later conditions, which would drop the title. -->
  <macro name="creators">
    <choose>
      <if variable="author">
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", " initialize-with="."/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", " initialize-with="."/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
      <else-if variable="translator">
        <names variable="translator">
          <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", " initialize-with="."/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <macro name="container-editors">
    <names variable="editor">
      <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" sort-separator=", " initialize-with="."/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="translators-verb">
    <group delimiter=" ">
      <text term="translator" form="verb" text-case="capitalize-first"/>
      <names variable="translator">
        <name and="text" delimiter=", " initialize-with="."/>
      </names>
    </group>
  </macro>

  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="day-month">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month"/>
    </date>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="title">
    <choose>
      <if type="book report thesis webpage post post-weblog legislation legal_case motion_picture software dataset map" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher">
    <text variable="publisher"/>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="article-journal" variable="number" match="all">
        <group delimiter=" ">
          <text value="article"/>
          <text variable="number"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="access">
    <group delimiter=" ">
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="Available at: https://doi.org/"/>
        </if>
        <else-if variable="URL">
          <text variable="URL" prefix="Available at: "/>
          <group delimiter=" " prefix="(" suffix=")">
            <text term="accessed" text-case="capitalize-first" suffix=":"/>
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>

  <!-- Sort keys for the PHP/JS sort-coordination tests. Output order is not
       used by the block (it sorts entries itself), and these macros share no
       elements with the display macros, whose name state they would disturb. -->
  <macro name="sort-contributors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="sort-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <bibliography hanging-indent="true" et-al-min="4" et-al-use-first="1">
    <sort>
      <key macro="sort-contributors"/>
      <key macro="sort-year"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" " suffix=".">
        <choose>
          <if variable="author editor translator" match="any">
            <group delimiter=" ">
              <text macro="creators"/>
              <text macro="year" prefix="(" suffix=")"/>
            </group>
          </if>
          <else>
            <group delimiter=" ">
              <text macro="title"/>
              <text macro="year" prefix="(" suffix=")"/>
            </group>
          </else>
        </choose>
        <choose>
          <if type="article-journal review review-book" match="any">
            <group delimiter=", " suffix=".">
              <text macro="title"/>
              <text variable="container-title"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text macro="pages"/>
            </group>
          </if>
          <else-if type="article-magazine article-newspaper" match="any">
            <group delimiter=", " suffix=".">
              <text macro="title"/>
              <text variable="container-title"/>
              <text macro="day-month"/>
              <text macro="pages"/>
            </group>
          </else-if>
          <else-if type="chapter paper-conference entry entry-encyclopedia entry-dictionary" match="any">
            <group delimiter=", " suffix=".">
              <text macro="title"/>
              <group delimiter=" ">
                <text term="in"/>
                <text macro="container-editors"/>
                <text variable="container-title"/>
              </group>
            </group>
            <group delimiter=", " suffix=".">
              <text macro="publisher"/>
              <text macro="pages"/>
            </group>
          </else-if>
          <else-if type="thesis">
            <choose>
              <if variable="author editor translator" match="any">
                <text macro="title" suffix="."/>
              </if>
            </choose>
            <group delimiter=". " suffix=".">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <choose>
              <if variable="author editor translator" match="any">
                <text macro="title" suffix="."/>
              </if>
            </choose>
          </else-if>
          <else-if type="article">
            <choose>
              <if variable="author editor translator" match="any">
                <text macro="title" suffix="."/>
              </if>
            </choose>
            <group delimiter=" " suffix=".">
              <text variable="publisher"/>
              <text value="[Preprint]"/>
            </group>
          </else-if>
          <else-if type="legal_case">
            <group delimiter=" " suffix=".">
              <text variable="container-title"/>
              <text variable="number"/>
            </group>
          </else-if>
          <else-if type="legislation"/>
          <else>
            <choose>
              <if variable="author editor translator" match="any">
                <text macro="title" suffix="."/>
              </if>
            </choose>
            <choose>
              <if variable="author editor" match="any">
                <text macro="translators-verb" suffix="."/>
              </if>
            </choose>
            <text macro="edition" suffix="."/>
            <text variable="number" suffix="."/>
            <text macro="publisher" suffix="."/>
          </else>
        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
