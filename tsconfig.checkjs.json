{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"lib": [ "ES2022", "DOM" ],
		"strict": false,
		"skipLibCheck": true,
		"types": []
	},
	"include": [ "src/lib/**/*.js" ],
	"exclude": [
		"src/lib/**/*.test.js",
		"src/lib/__test-utils__/**",
		"src/lib/__fixtures__/**"
	]
}
