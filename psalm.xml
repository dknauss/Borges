<?xml version="1.0"?>
<psalm
	errorLevel="6"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="true"
	findUnusedCode="false"
	allFunctionsGlobal="true"
	allConstantsGlobal="true"
>
	<projectFiles>
		<file name="bibliography-builder.php" />
		<directory name="includes" />
		<ignoreFiles>
			<directory name="tests" />
		</ignoreFiles>
	</projectFiles>
	<issueHandlers>
		<!-- The plugin supports PHP 7.4, where #[\Override] is only a comment
		     and compatibility scanners flag it. -->
		<MissingOverrideAttribute errorLevel="suppress" />
	</issueHandlers>
	<stubs>
		<file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
	</stubs>
</psalm>
