# Match CI, which installs with `npm ci --legacy-peer-deps`. The eslint-plugin-
# import, -jsx-a11y, and -react versions that @wordpress/eslint-plugin pulls in
# declare peer ranges ending at ESLint 9, while this repo uses ESLint 10, so a
# strict peer check refuses to install. Without this, a plain `npm ci` fails
# and a plain `npm install` could write a differently resolved lockfile.
legacy-peer-deps=true
